# NightCap environment. Copy to .env (make setup does this and fills dev secrets).
# Nothing in here is ever bundled into the app except the EXPO_PUBLIC_* lines.

# --- Ports (shared laptop: never 8081, never NightOut's 8095) ---
METRO_PORT=8091
API_PORT=8788
# Local Supabase (only if you run `supabase start`; see supabase/config.toml): 54421–54429
SUPABASE_API_PORT=54421
SUPABASE_DB_PORT=54422
SUPABASE_STUDIO_PORT=54423

# --- Mode ---
# mock = PGlite (in-process Postgres with the real migrations + RLS) + local disk media + dev auth.
# Anything missing below keeps us in mock mode. See docs/STATUS.md → "Needs from you".
NIGHTCAP_MODE=mock
# PGlite data dir for mock mode (gitignored). Empty = in-memory (fresh seed every start).
PGLITE_DIR=.data/pglite
MEDIA_DIR=.data/media

# --- Dev secrets (generated by make setup; random per machine) ---
DEV_JWT_SECRET=
MEDIA_URL_SECRET=

# --- Production (leave empty for mock mode; API only, never the app) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nightcap-media
EXPO_PUSH_ACCESS_TOKEN=

# --- Mobile (public, bundled) ---
EXPO_PUBLIC_API_URL=http://127.0.0.1:8788
EXPO_PUBLIC_MOCK=1
